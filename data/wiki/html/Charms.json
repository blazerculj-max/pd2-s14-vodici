{"parse":{"title":"Charms","pageid":90,"redirects":[],"text":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Unique_Charms\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Unique Charms</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#Gheed&#39;s_Fortune\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\"><span>Gheed's Fortune</span></span></a></li>\n<li class=\"toclevel-2 tocsection-3\"><a href=\"#Hellfire_Torch\"><span class=\"tocnumber\">1.2</span> <span class=\"toctext\"><span>Hellfire Torch</span></span></a></li>\n<li class=\"toclevel-2 tocsection-4\"><a href=\"#Annihilus\"><span class=\"tocnumber\">1.3</span> <span class=\"toctext\"><span>Annihilus</span></span></a></li>\n<li class=\"toclevel-2 tocsection-5\"><a href=\"#Sunder_Charms\"><span class=\"tocnumber\">1.4</span> <span class=\"toctext\"><span>Sunder Charms</span></span></a>\n<ul>\n<li class=\"toclevel-3 tocsection-6\"><a href=\"#Black_Cleft\"><span class=\"tocnumber\">1.4.1</span> <span class=\"toctext\"><span>Black Cleft</span></span></a></li>\n<li class=\"toclevel-3 tocsection-7\"><a href=\"#Bone_Break\"><span class=\"tocnumber\">1.4.2</span> <span class=\"toctext\"><span>Bone Break</span></span></a></li>\n<li class=\"toclevel-3 tocsection-8\"><a href=\"#Cold_Rupture\"><span class=\"tocnumber\">1.4.3</span> <span class=\"toctext\"><span>Cold Rupture</span></span></a></li>\n<li class=\"toclevel-3 tocsection-9\"><a href=\"#Crack_of_the_Heavens\"><span class=\"tocnumber\">1.4.4</span> <span class=\"toctext\"><span>Crack of the Heavens</span></span></a></li>\n<li class=\"toclevel-3 tocsection-10\"><a href=\"#Flame_Rift\"><span class=\"tocnumber\">1.4.5</span> <span class=\"toctext\"><span>Flame Rift</span></span></a></li>\n<li class=\"toclevel-3 tocsection-11\"><a href=\"#Rotting_Fissure\"><span class=\"tocnumber\">1.4.6</span> <span class=\"toctext\"><span>Rotting Fissure</span></span></a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-12\"><a href=\"#Unique_Jewels\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Unique Jewels</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-13\"><a href=\"#Rainbow_Facet_(Fire)\"><span class=\"tocnumber\">2.1</span> <span class=\"toctext\"><span>Rainbow Facet (Fire)</span></span></a></li>\n<li class=\"toclevel-2 tocsection-14\"><a href=\"#Rainbow_Facet_(Cold)\"><span class=\"tocnumber\">2.2</span> <span class=\"toctext\"><span>Rainbow Facet (Cold)</span></span></a></li>\n<li class=\"toclevel-2 tocsection-15\"><a href=\"#Rainbow_Facet_(Lightning)\"><span class=\"tocnumber\">2.3</span> <span class=\"toctext\"><span>Rainbow Facet (Lightning)</span></span></a></li>\n<li class=\"toclevel-2 tocsection-16\"><a href=\"#Rainbow_Facet_(Poison)\"><span class=\"tocnumber\">2.4</span> <span class=\"toctext\"><span>Rainbow Facet (Poison)</span></span></a></li>\n</ul>\n</li>\n</ul>\n</div>\n\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Unique_Charms\">Unique Charms</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=1\" title=\"Edit section: Unique Charms\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Gheed's_Fortune\"><span id=\"Gheed.27s_Fortune\"></span><span class=\"d2-gold\">Gheed's Fortune</span></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=2\" title=\"Edit section: Gheed&#39;s Fortune\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"item-image-text\"><figure class=\"mw-default-size mw-halign-left\" typeof=\"mw:File\"><a href=\"/wiki/File:Grand_Charm_2.png\" class=\"mw-file-description\"><img src=\"//static.wikitide.net/projectdiablo2wiki/3/32/Grand_Charm_2.png\" decoding=\"async\" loading=\"lazy\" width=\"28\" height=\"84\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure></div>\n<div class=\"item-info-box\">\n<p><b>Grand Charm</b></p>\n<p><b>Required Level:</b> 62</p>\n<p>&#160;<br />\n&#160;\n</p>\n</div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">Before</span></th>\n<th><span style=\"color:#F9C666\">After</span>\n</th></tr>\n<tr>\n<td>[80-160]% Extra Gold from Monsters</td>\n<td>[80-160]% Extra Gold from Monsters\n</td></tr>\n<tr>\n<td>[20-40]% Better Chance of Getting Magic Items</td>\n<td>[20-40]% Better Chance of Getting Magic Items\n</td></tr>\n<tr>\n<td>Reduces All Vendor Prices [10-15]%</td>\n<td>Reduces All Vendor Prices [10-15]%\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Hellfire_Torch\"><span class=\"d2-gold\">Hellfire Torch</span></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=3\" title=\"Edit section: Hellfire Torch\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"item-image-text\"><figure class=\"mw-default-size mw-halign-left\" typeof=\"mw:File\"><a href=\"/wiki/File:Hellfire_Torch.png\" class=\"mw-file-description\"><img src=\"//static.wikitide.net/projectdiablo2wiki/3/3c/Hellfire_Torch.png\" decoding=\"async\" loading=\"lazy\" width=\"28\" height=\"56\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure></div>\n<div class=\"item-info-box\">\n<p><b>Large Charm</b></p>\n<p><b>Required Level:</b> 75</p>\n<p>&#160;\n</p>\n</div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">Before</span></th>\n<th><span style=\"color:#F9C666\">After</span>\n</th></tr>\n<tr>\n<td><span class=\"omod\">5% Chance to cast level 10 Firestorm on Attack</span></td>\n<td><span class=\"omod\">Removed</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">+3 to [Random Class] Skills</span></td>\n<td><span class=\"nmod\">+2</span> to [Random Class] Skills\n</td></tr>\n<tr>\n<td></td>\n<td><span class=\"nmod\">+[30-60] to Vitality</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">+[10-20] to All Attributes</span></td>\n<td><span class=\"nmod\">+[10-20] to Energy</span>\n</td></tr>\n<tr>\n<td>All Resistances +[10-20]</td>\n<td>All Resistances +[10-20]\n</td></tr>\n<tr>\n<td><span class=\"omod\">+8 to Light Radius</span></td>\n<td><span class=\"nmod\">+[4-8]</span> to Light Radius\n</td></tr>\n<tr>\n<td><span class=\"omod\">Level 30 Hydra (10 Charges)</span></td>\n<td><span class=\"omod\">Removed</span>\n</td></tr></tbody></table>\n<p><b>Note:</b> This item drops from <a href=\"/wiki/Monsters#Ubers\" title=\"Monsters\">Uber Tristram</a>.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Annihilus\"><span class=\"d2-gold\">Annihilus</span></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=4\" title=\"Edit section: Annihilus\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"item-image-text\"><figure class=\"mw-default-size mw-halign-left\" typeof=\"mw:File\"><a href=\"/wiki/File:Annihilus.png\" class=\"mw-file-description\"><img src=\"//static.wikitide.net/projectdiablo2wiki/3/30/Annihilus.png\" decoding=\"async\" loading=\"lazy\" width=\"28\" height=\"28\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure></div>\n<div class=\"item-info-box\">\n<p><b>Small Charm</b></p>\n<p><b>Required Level:</b> 70</p>\n</div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">Before</span></th>\n<th><span style=\"color:#F9C666\">After</span>\n</th></tr>\n<tr>\n<td>+1 to All Skills</td>\n<td>+1 to All Skills\n</td></tr>\n<tr>\n<td></td>\n<td><span class=\"nmod\">+[30-60] to Vitality</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">+[10-20] to All Attributes</span></td>\n<td><span class=\"nmod\">+[10-20] to Energy</span>\n</td></tr>\n<tr>\n<td>All Resistances +[10-20]</td>\n<td>All Resistances +[10-20]\n</td></tr>\n<tr>\n<td>+[5-10]% to Experience Gained</td>\n<td>+[5-10]% to Experience Gained\n</td></tr></tbody></table>\n<p><b>Note:</b> This item drops from <a href=\"/wiki/Monsters#Diablo-Clone\" title=\"Monsters\">Diablo Clone</a> and can be corrupted with <a href=\"/wiki/Tainted_Worldstone_Shard\" class=\"mw-redirect\" title=\"Tainted Worldstone Shard\">Tainted Worldstone Shard</a>.\n</p><p><br />\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Sunder_Charms\"><span class=\"d2-gold\">Sunder Charms</span></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=5\" title=\"Edit section: Sunder Charms\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Sunder mechanics from Diablo II: Resurrected, as well as unique Grand Charms with this affix, are not implemented in Project Diablo 2.\n</p>\n<div class=\"mw-heading mw-heading4\"><h4 id=\"Black_Cleft\"><span class=\"d2-gold\">Black Cleft</span></h4><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=6\" title=\"Edit section: Black Cleft\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">D2 Resurrected</span></th>\n<th><span style=\"color:#F9C666\">Project D2</span>\n</th></tr>\n<tr>\n<td><span class=\"omod\">Monster Magic Immunity is Sundered</span></td>\n<td rowspan=\"2\"><span class=\"omod\">Not implemented</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">Magic Resist [-65-45]%</span>\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading4\"><h4 id=\"Bone_Break\"><span class=\"d2-gold\">Bone Break</span></h4><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=7\" title=\"Edit section: Bone Break\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">D2 Resurrected</span></th>\n<th><span style=\"color:#F9C666\">Project D2</span>\n</th></tr>\n<tr>\n<td><span class=\"omod\">Monster Physical Immunity is Sundered</span></td>\n<td rowspan=\"2\"><span class=\"omod\">Not implemented</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">Physical Damage Received Increased by [30-10]%</span>\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading4\"><h4 id=\"Cold_Rupture\"><span class=\"d2-gold\">Cold Rupture</span></h4><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=8\" title=\"Edit section: Cold Rupture\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">D2 Resurrected</span></th>\n<th><span style=\"color:#F9C666\">Project D2</span>\n</th></tr>\n<tr>\n<td><span class=\"omod\">Monster Cold Immunity is Sundered</span></td>\n<td rowspan=\"2\"><span class=\"omod\">Not implemented</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">Cold Resist [-90-70]%</span>\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading4\"><h4 id=\"Crack_of_the_Heavens\"><span class=\"d2-gold\">Crack of the Heavens</span></h4><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=9\" title=\"Edit section: Crack of the Heavens\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">D2 Resurrected</span></th>\n<th><span style=\"color:#F9C666\">Project D2</span>\n</th></tr>\n<tr>\n<td><span class=\"omod\">Monster Lightning Immunity is Sundered</span></td>\n<td rowspan=\"2\"><span class=\"omod\">Not implemented</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">Lightning Resist [-90-70]%</span>\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading4\"><h4 id=\"Flame_Rift\"><span class=\"d2-gold\">Flame Rift</span></h4><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=10\" title=\"Edit section: Flame Rift\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">D2 Resurrected</span></th>\n<th><span style=\"color:#F9C666\">Project D2</span>\n</th></tr>\n<tr>\n<td><span class=\"omod\">Monster Fire Immunity is Sundered</span></td>\n<td rowspan=\"2\"><span class=\"omod\">Not implemented</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">Fire Resist [-90-70]%</span>\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading4\"><h4 id=\"Rotting_Fissure\"><span class=\"d2-gold\">Rotting Fissure</span></h4><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=11\" title=\"Edit section: Rotting Fissure\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">D2 Resurrected</span></th>\n<th><span style=\"color:#F9C666\">Project D2</span>\n</th></tr>\n<tr>\n<td><span class=\"omod\">Monster Poison Immunity is Sundered</span></td>\n<td rowspan=\"2\"><span class=\"omod\">Not implemented</span>\n</td></tr>\n<tr>\n<td><span class=\"omod\">Poison Resist [-90-70]%</span>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Unique_Jewels\">Unique Jewels</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=12\" title=\"Edit section: Unique Jewels\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Rainbow_Facet_(Fire)\"><span id=\"Rainbow_Facet_.28Fire.29\"></span><span class=\"d2-gold\">Rainbow Facet (Fire)</span></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=13\" title=\"Edit section: Rainbow Facet (Fire)\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"item-image-text\"><figure class=\"mw-default-size mw-halign-left\" typeof=\"mw:File\"><a href=\"/wiki/File:Jewel_red.png\" class=\"mw-file-description\"><img src=\"//static.wikitide.net/projectdiablo2wiki/e/e9/Jewel_red.png\" decoding=\"async\" loading=\"lazy\" width=\"28\" height=\"28\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure></div>\n<div class=\"item-info-box\">\n<p><b>Jewel</b></p>\n<p><b>Required Level:</b> 49</p>\n</div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">Before</span></th>\n<th><span style=\"color:#F9C666\">After</span>\n</th></tr>\n<tr>\n<td>100% Chance to Cast Level 29 Blaze when you Level-Up<br /><i>or</i><br />100% Chance to Cast Level 31 Meteor when you Die</td>\n<td>100% Chance to Cast Level 29 <a href=\"/wiki/Blaze\" class=\"mw-redirect\" title=\"Blaze\">Blaze</a> when you Level-Up<br /><i>or</i><br />100% Chance to Cast Level 31 <a href=\"/wiki/Meteor\" class=\"mw-redirect\" title=\"Meteor\">Meteor</a> when you Die\n</td></tr>\n<tr>\n<td>Adds 17-45 Fire Damage</td>\n<td>Adds 17-45 Fire Damage\n</td></tr>\n<tr>\n<td>+[3-5]% to Fire Skill Damage</td>\n<td>+[3-5]% to Fire Skill Damage\n</td></tr>\n<tr>\n<td>-[3-5]% to Enemy Fire Resistance</td>\n<td>-[3-5]% to Enemy Fire Resistance\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Rainbow_Facet_(Cold)\"><span id=\"Rainbow_Facet_.28Cold.29\"></span><span class=\"d2-gold\">Rainbow Facet (Cold)</span></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=14\" title=\"Edit section: Rainbow Facet (Cold)\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"item-image-text\"><figure class=\"mw-default-size mw-halign-left\" typeof=\"mw:File\"><a href=\"/wiki/File:Jewel_blue.png\" class=\"mw-file-description\"><img src=\"//static.wikitide.net/projectdiablo2wiki/a/af/Jewel_blue.png\" decoding=\"async\" loading=\"lazy\" width=\"28\" height=\"28\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure></div>\n<div class=\"item-info-box\">\n<p><b>Jewel</b></p>\n<p><b>Required Level:</b> 49</p>\n</div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">Before</span></th>\n<th><span style=\"color:#F9C666\">After</span>\n</th></tr>\n<tr>\n<td>100% Chance to Cast Level 43 Frost Nova when you Level-Up<br /><i>or</i><br />100% Chance to Cast Level 37 Blizzard when you Die</td>\n<td>100% Chance to Cast Level 43 <a href=\"/wiki/Frost_Nova\" class=\"mw-redirect\" title=\"Frost Nova\">Frost Nova</a> when you Level-Up<br /><i>or</i><br />100% Chance to Cast Level 37 <a href=\"/wiki/Blizzard\" class=\"mw-redirect\" title=\"Blizzard\">Blizzard</a> when you Die\n</td></tr>\n<tr>\n<td>Adds 24-38 Cold Damage</td>\n<td>Adds 24-38 Cold Damage\n</td></tr>\n<tr>\n<td>+[3-5]% to Cold Skill Damage</td>\n<td>+[3-5]% to Cold Skill Damage\n</td></tr>\n<tr>\n<td>-[3-5]% to Enemy Cold Resistance</td>\n<td>-[3-5]% to Enemy Cold Resistance\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Rainbow_Facet_(Lightning)\"><span id=\"Rainbow_Facet_.28Lightning.29\"></span><span class=\"d2-gold\">Rainbow Facet (Lightning)</span></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=15\" title=\"Edit section: Rainbow Facet (Lightning)\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"item-image-text\"><figure class=\"mw-default-size mw-halign-left\" typeof=\"mw:File\"><a href=\"/wiki/File:Jewel_white.png\" class=\"mw-file-description\"><img src=\"//static.wikitide.net/projectdiablo2wiki/0/05/Jewel_white.png\" decoding=\"async\" loading=\"lazy\" width=\"28\" height=\"28\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure></div>\n<div class=\"item-info-box\">\n<p><b>Jewel</b></p>\n<p><b>Required Level:</b> 49</p>\n</div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">Before</span></th>\n<th><span style=\"color:#F9C666\">After</span>\n</th></tr>\n<tr>\n<td>100% Chance to Cast Level 41 Nova when you Level-Up<br /><i>or</i><br />100% Chance to Cast Level 47 Chain Lightning when you Die</td>\n<td>100% Chance to Cast Level 41 <a href=\"/wiki/Nova\" class=\"mw-redirect\" title=\"Nova\">Nova</a> when you Level-Up<br /><i>or</i><br />100% Chance to Cast Level 47 <a href=\"/wiki/Chain_Lightning\" class=\"mw-redirect\" title=\"Chain Lightning\">Chain Lightning</a> when you Die\n</td></tr>\n<tr>\n<td>Adds 1-74 Lightning Damage</td>\n<td>Adds 1-74 Lightning Damage\n</td></tr>\n<tr>\n<td>+[3-5]% to Lightning Skill Damage</td>\n<td>+[3-5]% to Lightning Skill Damage\n</td></tr>\n<tr>\n<td>-[3-5]% to Enemy Lightning Resistance</td>\n<td>-[3-5]% to Enemy Lightning Resistance\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Rainbow_Facet_(Poison)\"><span id=\"Rainbow_Facet_.28Poison.29\"></span><span class=\"d2-gold\">Rainbow Facet (Poison)</span></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/Charms?action=edit&amp;section=16\" title=\"Edit section: Rainbow Facet (Poison)\" rel=\"nofollow\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"item-image-text\"><figure class=\"mw-default-size mw-halign-left\" typeof=\"mw:File\"><a href=\"/wiki/File:Jewel_green.png\" class=\"mw-file-description\"><img src=\"//static.wikitide.net/projectdiablo2wiki/9/9a/Jewel_green.png\" decoding=\"async\" loading=\"lazy\" width=\"28\" height=\"28\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure></div>\n<div class=\"item-info-box\">\n<p><b>Jewel</b></p>\n<p><b>Required Level:</b> 49</p>\n</div>\n<table class=\"wikitable wikitable-2col\">\n<tbody><tr>\n<th><span style=\"color:#F9C666;\">Before</span></th>\n<th><span style=\"color:#F9C666\">After</span>\n</th></tr>\n<tr>\n<td>100% Chance to Cast Level 23 Venom when you Level-Up<br /><i>or</i><br />100% Chance to Cast Level 51 Poison Nova when you Die</td>\n<td>100% Chance to Cast Level 23 <a href=\"/wiki/Venom_(Skill)\" class=\"mw-redirect\" title=\"Venom (Skill)\">Venom</a> when you Level-Up<br /><i>or</i><br />100% Chance to Cast Level 51 <a href=\"/wiki/Poison_Nova\" class=\"mw-redirect\" title=\"Poison Nova\">Poison Nova</a> when you Die\n</td></tr>\n<tr>\n<td>+37 Poison Damage over 2 Seconds</td>\n<td>+37 Poison Damage over 2 Seconds\n</td></tr>\n<tr>\n<td>+[3-5]% to Poison Skill Damage</td>\n<td>+[3-5]% to Poison Skill Damage\n</td></tr>\n<tr>\n<td>